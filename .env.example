# PostgreSQL / Neon / other hosted PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Strong random secret used to sign the temporary admin login token
JWT_SECRET=replace-with-a-long-random-secret

# Password used by the "新增最新消息" button
ADMIN_PASSWORD=replace-with-your-admin-password

# Optional: set true only if your PostgreSQL provider does not use SSL
PGSSL_DISABLE=false
